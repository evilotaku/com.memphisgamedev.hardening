<linker>
  <!--
    The Cloud Code module response DTOs are populated by Newtonsoft via reflection, so High managed
    stripping in the consuming game would drop their reflection-only members (e.g. IssueResult.expires,
    which no code reads), breaking deserialization in the built player only. Preserve just these types;
    the rest of the assembly can still be stripped.
  -->
  <assembly fullname="MemphisGameDev.Hardening">
    <type fullname="MemphisGameDev.Hardening.IntegrityGuard/Result" preserve="all"/>
    <type fullname="MemphisGameDev.Hardening.IntegrityGuard/ChallengeResult" preserve="all"/>
    <type fullname="MemphisGameDev.Hardening.IntegrityGuard/PassCheck" preserve="all"/>
    <type fullname="MemphisGameDev.Hardening.LanLicence/IssueResult" preserve="all"/>
  </assembly>
</linker>
